  (CELL
     (CELLTYPE "PREICG_X0P5B_A9TR")
     (INSTANCE lp_riscv.RC_CG_HIER_INST0.RC_CGIC_INST)
     (DELAY
        (ABSOLUTE
          (PORT E (::0.0))
          (PORT CK (::0.0))
          (PORT SE (::0.0))
          (COND E==1'b0&&SE==1'b1 (IOPATH CK ECK (::130) (::90)))
          (COND E==1'b1&&SE==1'b0 (IOPATH CK ECK (::130) (::90)))
          (COND E==1'b1&&SE==1'b1 (IOPATH CK ECK (::130) (::90)))
          (COND E==1'b0&&SE==1'b0 (IOPATH CK ECK () (::90)))
        )
     )
     (TIMINGCHECK
        (SETUPHOLD (negedge E) (COND ENABLE_NOT_SE==1'b1 (posedge CK)) (::209) (::-173))
        (SETUPHOLD (posedge E) (COND ENABLE_NOT_SE==1'b1 (posedge CK)) (::201) (::-93))
     )
  )
